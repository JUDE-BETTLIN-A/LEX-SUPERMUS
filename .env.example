# ============================================================================
# LEX SUPERMUS — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your local values.
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lex_admin
POSTGRES_PASSWORD=change_me_in_production

# Per-service databases
STUDENT_DB_NAME=lex_student
ADVOCATE_DB_NAME=lex_advocate
CLIENT_DB_NAME=lex_client

# ----------------------------------------------------------------------------
# Service Ports
# ----------------------------------------------------------------------------
STUDENT_SERVICE_PORT=8081
ADVOCATE_SERVICE_PORT=8082
CLIENT_SERVICE_PORT=8083
LEGAL_LIBRARY_SERVICE_PORT=8084
AI_SERVICE_PORT=8085

# ----------------------------------------------------------------------------
# Frontend Configuration
# ----------------------------------------------------------------------------
# Direct service URL used by the demo pages until an API gateway is added.
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Security / JWT
# ----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-change-in-production
JWT_EXPIRATION_MS=86400000

# ----------------------------------------------------------------------------
# Bar Council API Integration
# ----------------------------------------------------------------------------
BAR_COUNCIL_API_URL=https://api.barcouncilofindia.org/v1
BAR_COUNCIL_API_KEY=your-bar-council-api-key
BAR_COUNCIL_API_SECRET=your-bar-council-api-secret

# ----------------------------------------------------------------------------
# SMTP / Email Configuration
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@lexsupermus.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_ADDRESS=noreply@lexsupermus.com
SMTP_FROM_NAME=LEX SUPERMUS

# ----------------------------------------------------------------------------
# Docker / Infrastructure  (wired up later — Docker files not added yet)
# ----------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME=lex-supermus
# NGINX_PORT=80
